{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Client-side GUI to log in with a Minecraft session ID. Includes a Valid/Invalid status display and an account editor (name + skin), and integrates into the multiplayer menu.",
  "authors": [
    "FuntaR"
  ],
  "contact": {
    "homepage": "None"
  },
  "license": "CC0-1.0",
  "icon": "assets/session-id-login-mod/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "dev.funtar.SessionIDLoginMod"
    ]
  },
  "mixins": [
    "session-id-login-mod.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader}",
    "minecraft": "${minecraft}"
  }
}
